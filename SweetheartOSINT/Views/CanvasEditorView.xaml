<UserControl x:Class="SweetheartOSINT.Views.CanvasEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="True"
             Background="Transparent"
             PreviewKeyDown="Root_PreviewKeyDown"
             PreviewKeyUp="Root_PreviewKeyUp">

    <UserControl.Resources>
        <ContextMenu x:Key="CanvasMenu">
            <MenuItem Header="Создать стикер" Click="CreateStickerFromMenu_Click" />
        </ContextMenu>
        <ContextMenu x:Key="LinkMenu">
            <MenuItem Header="Удалить связь" Click="DeleteLink_Click" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="#E6050505"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋ Стикер" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                            Command="{Binding AddStickerCommand}" ToolTip="Добавить стикер в центре вида" />
                    <Button Content="Удалить" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                            Command="{Binding DeleteSelectedCommand}" ToolTip="Удалить выбранный стикер (Delete)" />
                    <Button x:Name="PlayButton" Content="▶ Пуск" Style="{StaticResource SmallButton}"
                            Margin="0,0,6,0" Click="PlayButton_Click"
                            ToolTip="Поэтапно воспроизвести создание карты" />

                    <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="6,0,10,0" />

                    <Button Content="−" Style="{StaticResource SmallButton}" Width="30" Margin="0,0,4,0"
                            Command="{Binding ZoomOutCommand}" ToolTip="Уменьшить масштаб" />
                    <TextBlock Text="{Binding ZoomPercent}" FontSize="11" Foreground="{StaticResource TextBrush}"
                               Width="48" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="＋" Style="{StaticResource SmallButton}" Width="30" Margin="4,0,6,0"
                            Command="{Binding ZoomInCommand}" ToolTip="Увеличить масштаб" />
                    <Button Content="Вид 1:1" Style="{StaticResource SmallButton}"
                            Command="{Binding ResetViewCommand}" ToolTip="Сбросить масштаб и панораму" />

                    <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="6,0,10,0" />

                    <Button x:Name="LanguageButton" Content="RU" Style="{StaticResource SmallButton}"
                            Click="LanguageButton_Click"
                            ToolTip="Переключить язык ввода: русский / английский (один клик)" />
                </StackPanel>

                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="260,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Canvas -->
        <Grid x:Name="Viewport"
              Grid.Row="1"
              Focusable="True"
              ClipToBounds="True"
              Background="Transparent"
              ContextMenu="{StaticResource CanvasMenu}"
              PreviewMouseDown="Viewport_MouseDown"
              MouseMove="Viewport_MouseMove"
              MouseUp="Viewport_MouseUp"
              MouseWheel="Viewport_MouseWheel"
              SizeChanged="Viewport_SizeChanged">

            <Grid x:Name="World" RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <MatrixTransform x:Name="WorldTransform" />
                </Grid.RenderTransform>

                <!-- Connections -->
                <ItemsControl x:Name="LinksItemsControl"
                              ItemsSource="{Binding Links}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Path Data="{Binding Geometry}"
                                      Stroke="#01000000" StrokeThickness="18"
                                      StrokeLineJoin="Round" Cursor="Hand"
                                      ContextMenu="{StaticResource LinkMenu}"
                                      ToolTip="Правый клик — удалить связь" />
                                <Path Data="{Binding Geometry}"
                                      Stroke="#FFFFFF" StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Opacity="{Binding PlaybackOpacity}"
                                      IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Temporary connection while dragging from "+" -->
                <Path x:Name="TempLink"
                      Stroke="#FFFFFF" StrokeThickness="1.4"
                      StrokeDashArray="4,4" Opacity="0.7"
                      Visibility="Collapsed" IsHitTestVisible="False" />

                <!-- Stickers -->
                <ItemsControl x:Name="StickersItemsControl" ItemsSource="{Binding Stickers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                  Opacity="{Binding PlaybackOpacity}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding PlaybackScale}"
                                                    ScaleY="{Binding PlaybackScale}" />
                                </Grid.RenderTransform>

                                <Border Background="#151515"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        MouseDown="Sticker_MouseDown"
                                        AllowDrop="True"
                                        DragOver="Sticker_DragOver"
                                        Drop="Sticker_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FFFFFF" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header / drag zone -->
                                        <Grid Grid.Row="0" Background="#202020">
                                            <TextBlock Text="СТИКЕР" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="10,5,0,5" />
                                            <Button Content="×" Width="20" Height="20"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="0,0,6,0" Cursor="Hand"
                                                    Click="DeleteSticker_Click" ToolTip="Удалить стикер">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <!-- Editable text -->
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource TextBrush}"
                                                 CaretBrush="{StaticResource AccentBrush}"
                                                 Padding="10,8"
                                                 FontSize="12"
                                                 VerticalScrollBarVisibility="Auto" />

                                        <!-- Sticker image: scrollable, rotatable -->
                                        <Grid Grid.Row="2" Margin="8,0,8,4" Height="96"
                                              Visibility="{Binding ImagePath, Converter={StaticResource NullToCollapsed}}">
                                            <ScrollViewer x:Name="StickerImageScroll"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Background="#101010"
                                                          AllowDrop="True"
                                                          DragOver="Sticker_DragOver"
                                                          Drop="Sticker_Drop">
                                                <Image Source="{Binding ImagePath, Converter={StaticResource FileToImage}}"
                                                       Stretch="None"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                    <Image.LayoutTransform>
                                                        <RotateTransform Angle="{Binding ImageRotation}" />
                                                    </Image.LayoutTransform>
                                                </Image>
                                            </ScrollViewer>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" Margin="0,3,3,0">
                                                <Button Content="↻" Width="20" Height="20" Cursor="Hand"
                                                        Command="{Binding RotateImageCommand}"
                                                        ToolTip="Повернуть картинку на 90°">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="#CC000000" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Content="×" Width="20" Height="20" Cursor="Hand"
                                                        Margin="3,0,0,0"
                                                        Command="{Binding RemoveImageCommand}"
                                                        ToolTip="Убрать картинку">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="#CC000000" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Sources -->
                                        <ScrollViewer Grid.Row="3" MaxHeight="62" Margin="8,0,8,2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Sources}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="#0C0C0C"
                                                                     BorderBrush="{StaticResource BorderBrush}"
                                                                     BorderThickness="1"
                                                                     Foreground="{StaticResource TextBrush}"
                                                                     CaretBrush="{StaticResource AccentBrush}"
                                                                     FontSize="10" Padding="5,3" Height="24" />
                                                            <Button Grid.Column="1" Content="↗" Width="22" Height="24"
                                                                    Margin="3,0,0,0" Cursor="Hand"
                                                                    Click="OpenSource_Click" ToolTip="Открыть ссылку" />
                                                            <Button Grid.Column="2" Content="×" Width="22" Height="24"
                                                                    Margin="2,0,0,0" Cursor="Hand"
                                                                    Command="{Binding RemoveCommand}"
                                                                    ToolTip="Удалить источник" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Bottom actions -->
                                        <Grid Grid.Row="4" Margin="8,4,8,8">
                                            <Button Content="+ картинка" Style="{StaticResource SmallButton}"
                                                    HorizontalAlignment="Left"
                                                    Click="AddImage_Click" ToolTip="Добавить изображение" />
                                            <Button Width="22" Height="22" Content="+"
                                                    HorizontalAlignment="Right" Cursor="Cross"
                                                    FontSize="14" FontWeight="Bold"
                                                     Foreground="{StaticResource BgBrush}"
                                                     Background="{StaticResource AccentBrush}"
                                                     BorderBrush="{StaticResource AccentBrush}"
                                                     BorderThickness="1"
                                                     PreviewMouseDown="Connect_MouseDown"
                                                    ToolTip="Нажмите — добавить источник; протяните к другому стикеру — создать связь">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="11">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Resize handles -->
                                <Border Tag="NW" Width="10" Height="10" Background="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0"
                                        Cursor="SizeNWSE" MouseDown="Resize_MouseDown" />
                                <Border Tag="NE" Width="10" Height="10" Background="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                                        Cursor="SizeNESW" MouseDown="Resize_MouseDown" />
                                <Border Tag="SW" Width="10" Height="10" Background="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5"
                                        Cursor="SizeNESW" MouseDown="Resize_MouseDown" />
                                <Border Tag="SE" Width="10" Height="10" Background="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"
                                        Cursor="SizeNWSE" MouseDown="Resize_MouseDown" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Playback layer: cameras, cursors, banner -->
            <Canvas x:Name="PlayOverlay" Panel.ZIndex="5"
                    IsHitTestVisible="False" Background="Transparent">
                <Border x:Name="PlaybackBanner" Canvas.Left="16" Canvas.Top="16"
                        Padding="12,6" CornerRadius="4"
                        Background="#CC050505" BorderBrush="#444444" BorderThickness="1"
                        Visibility="Collapsed" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlaybackBannerText"
                                   Text="ВОСПРОИЗВЕДЕНИЕ · ПУСК"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                    </StackPanel>
                </Border>
            </Canvas>

            <!-- Pan hint -->
            <TextBlock x:Name="PanHint"
                       Text="ПКМ — стикер   ·   колесо — масштаб   ·   средняя кнопка / пробел — панорама"
                       FontSize="10" Foreground="#5A5A5A"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="14,0,0,10" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</UserControl>
