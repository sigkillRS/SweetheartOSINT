<UserControl x:Class="SweetheartOSINT.Views.WarpedGridBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             ClipToBounds="True"
             Background="#050505">

    <UserControl.Resources>
        <Storyboard x:Key="DriftStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GridCanvas"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-18" To="18" Duration="0:0:22" />
            <DoubleAnimation Storyboard.TargetName="GridCanvas"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="12" To="-12" Duration="0:0:22" />
        </Storyboard>

        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GridCanvas"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="1" Duration="0:0:7" />
        </Storyboard>
    </UserControl.Resources>

    <Grid IsHitTestVisible="False">
        <Canvas x:Name="GridCanvas"
                IsHitTestVisible="False"
                Opacity="0.75">
            <Canvas.RenderTransform>
                <TranslateTransform X="-18" Y="12" />
            </Canvas.RenderTransform>
        </Canvas>

        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45"
                                     RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#00000000" Offset="0.2" />
                    <GradientStop Color="#99050505" Offset="0.72" />
                    <GradientStop Color="#F0050505" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
