<Window x:Class="SweetheartOSINT.Views.ProjectWindow"
         Icon="/Resources/app.ico"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SweetheartOSINT.Views"
        Title="Проект"
        Width="1140"
        Height="740"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <views:WarpedGridBackground Grid.RowSpan="3" Grid.ColumnSpan="2" />
        <!-- Header -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{StaticResource HeaderGradientBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ПРОЕКТ" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentMutedBrush}" />
                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Инструменты" Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0" Click="ToolsToggle_Click" />
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Main content -->
        <TabControl Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource DarkTabControlStyle}">
            <TabItem Header="Источники и файлы" Style="{StaticResource DarkTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="24,20">
                            <StackPanel>
                        <!-- Parameters -->
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="ПАРАМЕТРЫ" Style="{StaticResource SectionTitle}"
                                           Foreground="{StaticResource AccentBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Название" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
                                        <TextBox x:Name="NameTextBox" Style="{StaticResource DarkTextBox}" Height="36"
                                                 MaxLength="80" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Процент" Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="PercentTextBox" Text="0" Width="52" Height="30"
                                                     HorizontalAlignment="Right" TextAlignment="Center"
                                                     Style="{StaticResource DarkTextBox}"
                                                     TextChanged="PercentTextBox_TextChanged" />
                                        </Grid>
                                        <Slider x:Name="PercentSlider" Minimum="0" Maximum="100" Value="0"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Foreground="{StaticResource AccentBrush}" Height="28" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- Sources -->
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="ИСТОЧНИКИ И ЗАМЕТКИ" Style="{StaticResource SectionTitle}"
                                           Foreground="{StaticResource AccentMutedBrush}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SourceTypeCombo" Style="{StaticResource DarkComboBox}"
                                              SelectedIndex="0" Height="36" Margin="0,0,8,0">
                                        <ComboBoxItem Content="Ссылка" />
                                        <ComboBoxItem Content="Заметка" />
                                    </ComboBox>
                                    <TextBox x:Name="SourceInputTextBox" Grid.Column="1"
                                             Style="{StaticResource DarkTextBox}" Height="36" Margin="0,0,8,0"
                                             TextWrapping="NoWrap"
                                             KeyDown="SourceInput_KeyDown" />
                                    <Button Content="Добавить" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                            Height="36" Click="AddSource_Click" />
                                </Grid>
                                <ItemsControl x:Name="SourcesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E6050505" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="56" Height="26" CornerRadius="6"
                                                            Background="#1A1A1A" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock Text="ССЫЛКА" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{StaticResource AccentMutedBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="ЗАМЕТКА" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{StaticResource AccentDimBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0">
                                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextBrush}" FontSize="13" />
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                                   Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Button Content="Открыть" Style="{StaticResource SmallButton}"
                                                                Click="OpenSource_Click"
                                                                Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Content="Удалить" Style="{StaticResource SmallButton}"
                                                                Margin="6,0,0,0" Click="DeleteSource_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SourcesEmptyText" Text="Источники пока не добавлены."
                                           Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="2,6,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Images -->
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="ГАЛЕРЕЯ" Style="{StaticResource SectionTitle}"
                                               Foreground="{StaticResource AccentDimBrush}" Margin="0" />
                                    <Button Content="＋ Добавить картинку" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" Click="AddImages_Click" />
                                </Grid>
                                <ItemsControl x:Name="ImagesItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="126" Height="120" Margin="0,0,10,10"
                                                    Background="#E6050505" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="9">
                                                <Grid>
                                                    <TextBlock Text="нет изображения" Style="{StaticResource SubtitleText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Converter={StaticResource FileToImage}}"
                                                           Stretch="UniformToFill" Margin="4" />
                                                    <Button Content="✕" Style="{StaticResource SmallButton}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,4,4,0" Padding="6,2"
                                                            ToolTip="Удалить изображение"
                                                            Click="DeleteImage_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ImagesEmptyText" Text="Картинки пока не добавлены."
                                           Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="2,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Карта" Style="{StaticResource DarkTabItemStyle}">
                <views:CanvasEditorView x:Name="CanvasEditor" />
            </TabItem>
        </TabControl>
        <!-- Status bar -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="#E6050505" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <TextBlock Text="Изменения применяются после нажатия «Сохранить» — тогда же обновляется превью карточки."
                           Style="{StaticResource SubtitleText}" />
                <TextBlock x:Name="StatsText" Style="{StaticResource SubtitleText}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <!-- Tools panel -->
        <Border x:Name="ToolsPanel" Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                Width="324" Visibility="Collapsed"
                Background="#E6050505" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="ИНСТРУМЕНТЫ" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Полезные сервисы" Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource SmallButton}"
                            HorizontalAlignment="Right" Click="ToolsToggle_Click" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ToolsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ToolLinkButton}" Margin="0,0,0,9"
                                        Click="ToolLink_Click" Tag="{Binding Url}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Url}" FontSize="10"
                                                   Foreground="{StaticResource AccentMutedBrush}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="Ссылки открываются в браузере по умолчанию."
                           Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>