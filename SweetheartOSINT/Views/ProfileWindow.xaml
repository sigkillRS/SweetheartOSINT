<Window x:Class="SweetheartOSINT.Views.ProfileWindow"
         Icon="/Resources/app.ico"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SweetheartOSINT.Views"
        Title="Профиль"
        Width="440"
        Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid>
        <views:WarpedGridBackground />
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Профиль"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,20" />
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Grid Width="104" Height="104">
                    <Ellipse Fill="#242424" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                    <Image x:Name="AvatarImage"
                           Width="104" Height="104"
                           Stretch="UniformToFill"
                           Visibility="Collapsed">
                        <Image.Clip>
                            <EllipseGeometry Center="52,52" RadiusX="52" RadiusY="52" />
                        </Image.Clip>
                    </Image>
                    <TextBlock x:Name="InitialsText"
                               Text="??"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
                <Button Content="Выбрать изображение..."
                        Style="{StaticResource GhostButton}"
                        Margin="0,14,0,0"
                        Click="BrowseAvatar_Click" />
                <TextBlock Text="PNG или JPG · файл копируется рядом с приложением"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Ник" Style="{StaticResource SectionTitle}" />
                <TextBox x:Name="NickTextBox"
                         Style="{StaticResource DarkTextBox}"
                         Height="38"
                         MaxLength="40" />
            </StackPanel>
            <TextBlock Grid.Row="3"
                       Text="Аватарка и ник сохраняются в profile.json в корне приложения."
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="100"
                        Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="125"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>