<Window x:Class="SweetheartOSINT.Views.MainWindow"
         Icon="/Resources/app.ico"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SweetheartOSINT.Views"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Sweetheart OSINT"
        Height="700"
        Width="1060"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <views:WarpedGridBackground Grid.RowSpan="3" />
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradientBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sweetheart" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text=" OSINT" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AccentDimBrush}" />
                    </StackPanel>
                    <TextBlock Text="Проекты · источники · инструменты разведки"
                               Style="{StaticResource SubtitleText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="＋  Создать проект"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CreateProject_Click" />
            </Grid>
        </Border>
        <!-- Projects grid -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10,18">
                <Grid>
                    <ItemsControl x:Name="ProjectsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="CardRoot">
                                <Button Style="{StaticResource ProjectCardButtonStyle}"
                                        Click="ProjectCard_Click"
                                        ToolTip="{Binding Name}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="160" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="{StaticResource CardPreviewGradientBrush}">
                                            <Grid>
                                                <TextBlock Text="Превью появится после сохранения"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding PreviewPath, Converter={StaticResource FileToImage}}"
                                                       Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="14,12">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SourcesCount, StringFormat='Источников: {0}'}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,3,0,0" />
                                            <ProgressBar Value="{Binding Percent}"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Style="{StaticResource MinimalProgress}"
                                                         Margin="0,10,0,0" />
                                            <Grid Margin="0,7,0,0">
                                                <TextBlock Text="{Binding Percent, StringFormat={}{0}%}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="13" />
                                                <TextBlock Text="открыть →"
                                                           Foreground="{StaticResource AccentMutedBrush}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Width="30" Height="30"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,8,8,0" Cursor="Hand"
                                        Click="DeleteProject_Click"
                                        ToolTip="Удалить проект"
                                        automation:AutomationProperties.Name="Удалить проект">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path Data="M3,4 L13,4 M6,4 L6,2 L10,2 L10,4 M5,4 L6,14 L10,14 L11,4 M7,6 L7,12 M9,6 L9,12"
                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.2"
                                          Fill="Transparent" />
                                </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="EmptyHint"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Пока нет проектов"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Нажмите «Создать проект», чтобы начать"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
        <!-- Profile -->
        <Border Grid.Row="2"
                Background="#E6050505"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Button x:Name="ProfileButton"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        Cursor="Hand"
                        Click="Profile_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="4">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1E1E1E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="#242424" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Image x:Name="AvatarImage"
                                   Width="40" Height="40"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed">
                                <Image.Clip>
                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                </Image.Clip>
                            </Image>
                            <TextBlock x:Name="InitialsText"
                                       Text="??"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NickText"
                                       Text="Без ника"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Профиль и настройки"
                                       Style="{StaticResource SubtitleText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <TextBlock Text="Данные хранятся локально · Projects / profile.json"
                           Style="{StaticResource SubtitleText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>