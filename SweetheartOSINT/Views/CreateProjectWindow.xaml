<Window x:Class="SweetheartOSINT.Views.CreateProjectWindow"
         Icon="/Resources/app.ico"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SweetheartOSINT.Views"
        Title="Новый проект"
        Width="470"
        Height="370"
        MinWidth="420"
        MinHeight="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid>
        <views:WarpedGridBackground />
        <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Создать проект" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Новая ветка с источниками и заметками"
                       Style="{StaticResource SubtitleText}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="Название проекта" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="NameTextBox"
                     Style="{StaticResource DarkTextBox}"
                     Height="38"
                     MaxLength="80"
                     KeyDown="Input_KeyDown" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Процент готовности" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBox x:Name="PercentTextBox"
                         Text="0"
                         Width="56"
                         Height="32"
                         HorizontalAlignment="Right"
                         TextAlignment="Center"
                         Style="{StaticResource DarkTextBox}"
                         TextChanged="PercentTextBox_TextChanged"
                         KeyDown="Input_KeyDown" />
            </Grid>
            <Slider x:Name="PercentSlider"
                    Minimum="0" Maximum="100" Value="0"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Height="28"
                    Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
        <TextBlock Grid.Row="3"
                   Text="Значение от 0 до 100. Процент отображается на карточке проекта."
                   Style="{StaticResource MutedText}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="105"
                    Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Content="Создать" Style="{StaticResource PrimaryButton}" Width="130"
                    Click="Create_Click" />
        </StackPanel>
        </Grid>
    </Grid>
</Window>